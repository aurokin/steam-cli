{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/review-case-0.1.json",
  "title": "Steam Agent route-blind qualitative review case 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution", "target", "prompt", "parser", "presentation", "projection"],
  "properties": {
    "schema": {"const": "steam-agent-eval-review-case/0.1"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_input", "criterion_coverage", "external_context", "response_schema"],
      "properties": {
        "model_input": {"const": "this_document_verbatim"},
        "criterion_coverage": {"const": "every_projection_criterion_exactly_once"},
        "external_context": {"const": "forbidden"},
        "response_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "sha256"],
          "properties": {
            "schema": {"const": "steam-agent-eval-review-verdicts/0.1"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_id", "work_item_id", "report_sha256", "scenario_sha256", "rubric_sha256", "projection_sha256"],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/token"},
        "work_item_id": {"$ref": "#/$defs/token"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "text"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "document"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "document": {"type": "object"}
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blinded_label", "order"],
      "properties": {
        "blinded_label": {"const": "candidate-A"},
        "order": {"const": 0}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "criteria", "answers", "claims_sidecars"],
      "properties": {
        "schema": {"const": "steam-agent-eval-qualitative-projection/0.2"},
        "criteria": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object"}},
        "answers": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object"}},
        "claims_sidecars": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object"}}
      }
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}/[0-9]+\\.[0-9]+$"}
  }
}
