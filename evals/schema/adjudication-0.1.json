{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/adjudication-0.1.json",
  "title": "Steam Agent qualitative adjudication 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adjudication_id",
    "target",
    "method",
    "adjudicator",
    "judgment_sha256s",
    "outcomes",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "steam-agent-eval-adjudication/0.1"},
    "adjudication_id": {"$ref": "#/$defs/token"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "work_item_id",
        "report_sha256",
        "scenario_sha256",
        "rubric_sha256",
        "projection_sha256"
      ],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/token"},
        "work_item_id": {"$ref": "#/$defs/token"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "method": {"enum": ["agreement", "human_adjudication"]},
    "adjudicator": {"$ref": "#/$defs/token"},
    "judgment_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "outcome"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "outcome": {"enum": ["pass", "fail", "unresolved"]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
