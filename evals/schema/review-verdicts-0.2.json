{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/review-verdicts-0.2.json",
  "title": "Steam Agent external qualitative review verdicts 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "invocation",
    "verdicts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "steam-agent-eval-review-verdicts/0.2"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "projection_sha256"
      ],
      "properties": {
        "work_item_id": {
          "type": "string",
          "pattern": "^w-[0-9]{6}-[0-9a-f]{16}$"
        },
        "projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "judge_identifier",
        "binding_sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^package-[0-9a-f]{64}$"
        },
        "judge_identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "verdict",
          "rationale"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "uncertain"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S+(?:\\s+\\S+){0,11}$"
          }
        }
      }
    }
  }
}
