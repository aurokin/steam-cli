{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/review-verdicts-0.1.json",
  "title": "Steam Agent external qualitative review verdicts 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdicts"],
  "properties": {
    "schema": {"const": "steam-agent-eval-review-verdicts/0.1"},
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "verdict", "rationale"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
          "verdict": {"enum": ["pass", "fail", "uncertain"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S+(?:\\s+\\S+){0,11}$"}
        }
      }
    }
  }
}
