{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/review-case-0.2.json",
  "title": "Steam Agent route-blind qualitative review case 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "execution",
    "target",
    "prompt",
    "parser",
    "presentation",
    "projection"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "steam-agent-eval-review-case/0.2"
    },
    "package_id": {
      "$ref": "#/$defs/package_id"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_input",
        "criterion_coverage",
        "external_context",
        "response_schema",
        "invocation"
      ],
      "properties": {
        "model_input": {
          "type": "string",
          "const": "this_document_verbatim"
        },
        "criterion_coverage": {
          "type": "string",
          "const": "every_projection_criterion_exactly_once"
        },
        "external_context": {
          "type": "string",
          "const": "forbidden"
        },
        "response_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256",
            "validator"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "const": "steam-agent-eval-review-verdicts/0.2"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "validator": {
              "type": "string",
              "const": "codex-structured-output-subset/0.1"
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_id",
            "judge_identifier",
            "binding_sha256"
          ],
          "properties": {
            "package_id": {
              "$ref": "#/$defs/package_id"
            },
            "judge_identifier": {
              "$ref": "#/$defs/token"
            },
            "binding_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "work_item_id",
        "report_sha256",
        "scenario_sha256",
        "rubric_sha256",
        "projection_sha256"
      ],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/token"},
        "work_item_id": {"$ref": "#/$defs/token"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "text"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "document"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "document": {"type": "object"}
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blinded_label", "order"],
      "properties": {
        "blinded_label": {"type": "string", "const": "candidate-A"},
        "order": {"type": "integer", "const": 0}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "criteria", "answers", "claims_sidecars"],
      "properties": {
        "schema": {
          "type": "string",
          "const": "steam-agent-eval-qualitative-projection/0.2"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"type": "object"}
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "object"}
        },
        "claims_sidecars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_id": {
      "type": "string",
      "pattern": "^package-[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}/[0-9]+\\.[0-9]+$"
    }
  }
}
