{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/judgment-0.1.json",
  "title": "Steam Agent blinded qualitative judgment 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "judgment_id",
    "target",
    "judge",
    "prompt",
    "parser",
    "presentation",
    "verdicts",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "steam-agent-eval-judgment/0.1"},
    "judgment_id": {"$ref": "#/$defs/token"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "work_item_id",
        "report_sha256",
        "scenario_sha256",
        "rubric_sha256",
        "projection_sha256"
      ],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/token"},
        "work_item_id": {"$ref": "#/$defs/token"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "model",
        "reasoning_effort",
        "settings_identity",
        "settings_sha256"
      ],
      "properties": {
        "kind": {"enum": ["human", "model"]},
        "identifier": {"$ref": "#/$defs/token"},
        "model": {"$ref": "#/$defs/token"},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "settings_identity": {"$ref": "#/$defs/token"},
        "settings_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {"$ref": "#/$defs/versionedDigest"},
    "parser": {"$ref": "#/$defs/versionedDigest"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blinded_label", "order"],
      "properties": {
        "blinded_label": {
          "type": "string",
          "pattern": "^candidate-[A-Z][A-Z0-9]{0,15}$"
        },
        "order": {"type": "integer", "minimum": 0, "maximum": 31}
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "verdict", "rationale"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "verdict": {"enum": ["pass", "fail", "uncertain"]},
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S+(?:\\s+\\S+){0,11}$"
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}/[0-9]+\\.[0-9]+$"
    },
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
