{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-agent.invalid/evals/schema/scenario-0.2.json",
  "title": "Steam Agent common-question scenario 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "milestone",
    "scenario_kind",
    "question_family",
    "tags",
    "frozen_time",
    "fixture",
    "conversation",
    "tool_policy",
    "deterministic_oracle",
    "fact_rubric",
    "judged_answer_rubric",
    "privacy_canaries"
  ],
  "properties": {
    "schema_version": {"const": "steam-agent-eval/0.2"},
    "id": {"type": "string", "pattern": "^m[1-9][0-9]*-[a-z][0-9]{2,}$"},
    "status": {"enum": ["active", "proposed"]},
    "milestone": {"type": "string", "pattern": "^M[1-9][0-9]*$"},
    "scenario_kind": {"enum": ["contract", "boundary"]},
    "question_family": {"type": "string", "minLength": 3},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "frozen_time": {"type": "string", "format": "date-time"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "facts"],
      "properties": {
        "kind": {"const": "synthetic_normalized"},
        "description": {"type": "string", "minLength": 10},
        "facts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "state"],
            "properties": {
              "subject": {"type": "string", "pattern": "^synthetic:"},
              "state": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "paraphrase": {"type": "string", "minLength": 3}
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "required", "prohibited"],
      "properties": {
        "allowed": {"$ref": "#/$defs/stringSet"},
        "required": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "arguments"],
            "properties": {
              "command": {"type": "string", "pattern": "^steam-agent "},
              "arguments": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "prohibited": {"$ref": "#/$defs/stringSet"}
      }
    },
    "deterministic_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_or_contract", "assertions"],
      "properties": {
        "recipe_or_contract": {"type": "string", "minLength": 3},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "fact_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grading", "criteria"],
      "properties": {
        "grading": {"const": "deterministic"},
        "required_claim_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\$\\."}
        },
        "criteria": {"$ref": "#/$defs/criteria"}
      }
    },
    "judged_answer_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grading", "status", "criteria"],
      "properties": {
        "grading": {"const": "model_or_human"},
        "status": {"const": "opt_in"},
        "criteria": {"$ref": "#/$defs/criteria"}
      }
    },
    "privacy_canaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steam_id64", "credential", "local_path"],
      "properties": {
        "steam_id64": {"type": "string", "pattern": "^EVAL_CANARY_STEAMID64_"},
        "credential": {"type": "string", "pattern": "^EVAL_CANARY_CREDENTIAL_"},
        "local_path": {"type": "string", "pattern": "^EVAL_CANARY_LOCAL_PATH_"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["scenario_kind"],
        "properties": {"scenario_kind": {"const": "contract"}}
      },
      "then": {
        "properties": {
          "fixture": {"properties": {"facts": {"minItems": 1}}},
          "tool_policy": {"properties": {"required": {"minItems": 1}}}
        }
      }
    },
    {
      "if": {
        "required": ["tool_policy"],
        "properties": {
          "tool_policy": {
            "required": ["required"],
            "properties": {"required": {"minItems": 1}}
          }
        }
      },
      "then": {
        "properties": {
          "fact_rubric": {
            "required": ["required_claim_paths"],
            "properties": {"required_claim_paths": {"minItems": 1}}
          }
        }
      }
    }
  ],
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "expected"],
      "properties": {
        "path": {"type": "string", "pattern": "^\\$"},
        "operator": {
          "enum": [
            "equals",
            "contains",
            "omits",
            "ordered_equals",
            "one_of",
            "must_not_execute",
            "refusal_expected"
          ]
        },
        "expected": {},
        "source": {"enum": ["cli_document", "final_answer", "trace"]},
        "turn": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "required": ["operator"],
            "properties": {"operator": {"const": "must_not_execute"}}
          },
          "then": {
            "required": ["source"],
            "properties": {
              "source": {"const": "trace"},
              "path": {"const": "$"},
              "expected": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        {
          "if": {
            "required": ["operator"],
            "properties": {"operator": {"const": "refusal_expected"}}
          },
          "then": {
            "required": ["source"],
            "properties": {
              "source": {"const": "final_answer"},
              "expected": {"type": "string", "pattern": "\\S"},
              "path": {"const": "$"}
            }
          }
        },
        {
          "if": {
            "required": ["operator"],
            "properties": {"operator": {"const": "one_of"}}
          },
          "then": {
            "properties": {
              "expected": {"type": "array", "minItems": 1}
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"not": {"required": ["source"]}},
              {
                "required": ["source"],
                "properties": {"source": {"const": "cli_document"}}
              }
            ]
          },
          "then": {
            "properties": {
              "path": {"pattern": "^\\$\\."},
              "operator": {
                "enum": [
                  "equals",
                  "contains",
                  "omits",
                  "ordered_equals",
                  "one_of"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["source"],
            "properties": {"source": {"const": "final_answer"}}
          },
          "then": {
            "properties": {
              "path": {"const": "$"},
              "operator": {
                "enum": ["contains", "omits", "refusal_expected"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {"enum": ["contains", "omits"]}
                  }
                },
                "then": {"properties": {"expected": {"type": "string"}}}
              }
            ]
          }
        },
        {
          "if": {
            "required": ["source"],
            "properties": {"source": {"const": "trace"}}
          },
          "then": {
            "properties": {
              "path": {"const": "$"},
              "operator": {"const": "must_not_execute"},
              "expected": {"type": "string", "pattern": "\\S"}
            }
          }
        }
      ]
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight", "requirement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "weight": {"type": "integer", "minimum": 1, "maximum": 10},
          "requirement": {"type": "string", "minLength": 5},
          "hard_fail": {"type": "boolean"}
        }
      }
    }
  }
}
